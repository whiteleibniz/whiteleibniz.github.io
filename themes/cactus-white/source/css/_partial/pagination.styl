.pagination
  display: inline-block
  margin-top: 2rem
  text-align: center
  width: 100%

  .page-number
    color: $color-text
    font-size: 0.8rem

  a
    color: $color-text
    padding: 4px 6px
    text-decoration: none
    border-radius: 5px
    background-color: $color-accent
    background-image: none

  a:hover
    background-image: none

  a:hover:not(.active)
    color: $color-lightest

  // 数字分页
  .page-num
    display: inline-block
    min-width: 1.6em
    margin: 0 2px
    text-align: center

  .page-number.current
    display: inline-block
    min-width: 1.6em
    margin: 0 2px
    padding: 4px 6px
    text-align: center
    border-radius: 5px
    background-color: $color-accent
    color: $color-lightest
    font-weight: 700

  .page-ellipsis
    margin: 0 4px
    color: $color-light

  .page-total
    display: block
    margin-top: 0.6em
    color: $color-light
    font-size: 0.75rem

  .extend
    margin: 0 4px
