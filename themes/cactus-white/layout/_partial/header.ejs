<header id="header">
    <a href="<%- url_for("/") %>">
        <% if (theme.customize.logo && theme.customize.logo.enabled) { %>
        <% if (theme.customize.gravatar.email && theme.customize.logo.gravatar) { %>
        <div id="logo" style="background-image: url(<%- gravatar(theme.customize.gravatar.email) %>);"></div>
        <% } else { %>
        <div id="logo" style="background-image: url(<%- url_for(theme.customize.logo.url) %>);"></div>
        <% } %>
        <% } %>
        <div id="title">
            <h1><%= config.title %></h1>
        </div>
    </a>
    <div id="nav">
        <ul>
            <li class="icon">
                <a href="#"><i class="fa fa-bars fa-2x"></i></a>
            </li>
            <% for (var i in theme.nav) { %>
            <% if (i == "article") { %>
            <li class="has-sub">
                <a class="navlink" href="<%- url_for(theme.nav[i]) %>"><span data-i18n="nav.<%= i %>"><%= i %></span> <i class="fa fa-angle-down"></i></a>
                <ul class="sub-nav">
                    <% var cur_lang = page.lang || 'zh-CN'; %>
                    <% site.categories.sort('name').each(function (cat) {
                         if (cat.posts.length && !cat.parent) {
                         var n = cat.posts.filter(function (p) { return (p.lang || 'zh-CN') === cur_lang; }).length;
                         if (n) { %>
                    <li><a class="catlink" data-cat="<%= cat.name %>" href="<%- url_for(cat.path) %>"><span class="cat-name"><%= cat.name %></span><span class="cat-count">（<%= n %>）</span></a></li>
                    <% } } }); %>
                </ul>
            </li>
            <% } else { %>
            <li><a class="navlink" href="<%- url_for(theme.nav[i]) %>"><span data-i18n="nav.<%= i %>"><%= i %></span></a></li>
            <% } %>
            <% } %>
            <li class="lang-switch">
                <a href="javascript:void(0)" data-lang="zh-CN">简体</a><span class="lang-sep">/</span><a href="javascript:void(0)" data-lang="zh-TW">繁體</a><span class="lang-sep">/</span><a href="javascript:void(0)" data-lang="en">EN</a>
            </li>
        </ul>
    </div>
</header>
