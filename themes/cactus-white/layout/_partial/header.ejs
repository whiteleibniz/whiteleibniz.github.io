<%
/* 服务端直出语言切换链接(不依赖 JS, 兼容带/不带尾斜杠) */
function _toPN(p){ if(!p || p==='index.html') return '/'; return '/' + String(p).replace(/index\.html$/,'').replace(/\/$/,'') + '/'; }
function _langOf(pn){ if(pn.indexOf('/en/')===0) return 'en'; if(pn.indexOf('/zh-tw/')===0) return 'zh-TW'; return 'zh-CN'; }
var _curPN = _toPN(page.path);
var _curLang = _langOf(_curPN);
var _ABOUT = { 'zh-CN':'/关于/', 'zh-TW':'/zh-tw/关于/', 'en':'/en/about/' };
function _sw(pn, target){
  var cur = _langOf(pn);
  if (cur === target) return pn;
  if (pn === _ABOUT[cur] || pn.replace(/index\.html$/,'') === _ABOUT[cur].replace(/index\.html$/,'') ) return _ABOUT[target];
  var base = pn.replace(/^\/(en|zh-tw)\//, '/');
  var pre = target==='en' ? '/en' : target==='zh-TW' ? '/zh-tw' : '';
  if (base === '/' || base === '') return pre === '' ? '/' : pre + '/';
  return pre + base;
}
var _LANGS = [['zh-CN','简体'],['zh-TW','繁體'],['en','EN']];
%>
<header id="header">
    <a href="<%- url_for("/") %>">
        <% if (theme.customize.logo && theme.customize.logo.enabled) { %>
        <% if (theme.customize.gravatar.email && theme.customize.logo.gravatar) { %>
        <div id="logo" style="background-image: url(<%- gravatar(theme.customize.gravatar.email) %>);"></div>
        <% } else { %>
        <div id="logo" style="background-image: url(<%- url_for(theme.customize.logo.url) %>);"></div>
        <% } %>
        <% } %>
        <div id="title">
            <h1><%= config.title %></h1>
        </div>
    </a>
    <div id="nav">
        <ul>
            <li class="icon">
                <a href="#"><i class="fa fa-bars fa-2x"></i></a>
            </li>
            <% for (var i in theme.nav) { %>
            <% if (i == "article") { %>
            <li class="has-sub">
                <a class="navlink" href="<%- url_for(theme.nav[i]) %>"><span data-i18n="nav.<%= i %>"><%= i %></span> <i class="fa fa-angle-down"></i></a>
                <ul class="sub-nav">
                    <% var cur_lang = page.lang || 'zh-CN'; %>
                    <% site.categories.sort('name').each(function (cat) {
                         if (cat.posts.length && !cat.parent) {
                         var n = cat.posts.filter(function (p) { return (p.lang || 'zh-CN') === cur_lang; }).length;
                         if (n) { %>
                    <li><a class="catlink" data-cat="<%= cat.name %>" href="<%- url_for(cat.path) %>"><span class="cat-name"><%= cat.name %></span><span class="cat-count">（<%= n %>）</span></a></li>
                    <% } } }); %>
                </ul>
            </li>
            <% } else { %>
            <li><a class="navlink" href="<%- url_for(theme.nav[i]) %>"><span data-i18n="nav.<%= i %>"><%= i %></span></a></li>
            <% } %>
            <% } %>
            <li class="lang-switch">
                <% _LANGS.forEach(function (L, k) { var _code = L[0]; var _href = _sw(_curPN, _code); var _cls = (_code === _curLang) ? 'current' : ''; %>
                <a href="<%= _href %>" data-lang="<%= _code %>" class="<%= _cls %>"><%= L[1] %></a><% if (k < _LANGS.length - 1) { %><span class="lang-sep">/</span><% } %>
                <% }); %>
            </li>
        </ul>
    </div>
</header>
