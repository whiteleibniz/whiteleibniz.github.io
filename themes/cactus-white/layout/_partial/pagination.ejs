<% if (page.total > 1) { %>
<%
  var cur = page.current, total = page.total;
  var items = [], last = 0;
  for (var i = 1; i <= total; i++) {
    if (i === 1 || i === total || Math.abs(i - cur) <= 1) {
      if (last && i - last > 1) items.push({ t: 'dot' });
      items.push({ t: 'n', n: i });
      last = i;
    }
  }
  function pageUrl(n) {
    return url_for(n === 1 ? (page.base || '/') : page.base + 'page/' + n + '/');
  }
%>
<div class="pagination">
    <% if (page.prev) { %>
        <a class="extend prev" href="<%- url_for(page.prev_link) %>" data-i18n-title="pag.prev"><i class="fa fa-angle-left"></i></a>
    <% } %>
    <% items.forEach(function (it) { %>
        <% if (it.t === 'dot') { %>
            <span class="page-ellipsis">…</span>
        <% } else if (it.n === cur) { %>
            <span class="page-number current"><%= it.n %></span>
        <% } else { %>
            <a class="page-num" href="<%- pageUrl(it.n) %>"><%= it.n %></a>
        <% } %>
    <% }); %>
    <% if (page.next) { %>
        <a class="extend next" href="<%- url_for(page.next_link) %>" data-i18n-title="pag.next"><i class="fa fa-angle-right"></i></a>
    <% } %>
    <span class="page-total" data-i18n-total="<%= cur %>|<%= total %>">（第 <%= cur %> / <%= total %> 页）</span>
</div>
<% } %>
